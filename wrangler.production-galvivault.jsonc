{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galvicare-0-5-production",
  "main": "worker/production-galvivault-integration.js",
  "compatibility_date": "2026-07-23",
  "keep_vars": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ENV": "production",
    "RELEASE_BRANCH": "main",
    "GALVIVAULT_NAME": "galvivault-0-5-production",
    "GALVIVAULT_DAY9_CONTINUITY_BRIDGE": "true",
    "FIXTURE_MODE": "false",
    "API_VERSION": "v1",
    "MIN_SCHEMA_VERSION": "0006",
    "ALLOWED_ORIGIN": "https://www.galvipro.com",
    "ALLOWED_ORIGINS": "https://www.galvipro.com,https://galvipro.com,https://mrgalvipro.github.io",
    "HUBSPOT_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "galvivault-0-5-production",
      "database_id": "2fc954b7-00ca-405b-8313-f91e706845a2"
    }
  ]
}
