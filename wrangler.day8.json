{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galvivault-day8-qa",
  "main": "worker/day8-entry.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./clinician-portal",
