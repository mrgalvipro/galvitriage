    "MIN_SCHEMA_VERSION": "0005",
    "ALLOWED_ORIGINS": "https://galvivault-day8-qa.mrgalvipro.workers.dev,https://clinician-qa.galvipro.com,http://localhost:8788"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "galvivault-0-5-qa",
      "database_id": "cdf9042b-ab09-498a-ac66-010b6cce47d4"
    }
  ]
}
